# 复制为 .env 后填入真实值。不要把 .env 或真实密钥提交到 Git。
# mock：无网回归。real：把 APP_ASR_PROVIDER / APP_LLM_PROVIDER 改成 volc / bailian 并填密钥。

APP_ASR_PROVIDER=mock
APP_LLM_PROVIDER=mock
APP_ANALYSIS_INLINE=auto
APP_PUBLIC_BASE_URL=http://localhost:8092
APP_AUDIO_TOKEN_TTL_SECONDS=900

# 火山引擎豆包语音 · 大模型录音文件识别
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=volc.bigasr.auc
VOLC_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLC_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
VOLC_ASR_HOTWORDS=
VOLC_ASR_CALLBACK_SECRET=
VOLC_ASR_UID=mobile-badge

# 阿里云百炼通义千问。默认 qwen3.7-flash，可改为 qwen3.7-plus 或 qwen-plus
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Webhook HMAC secret 的静态加密密钥。生产建议设置，避免数据库明文。
WEBHOOK_DATA_KEY=
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_CONNECT_TIMEOUT_MS=5000
WEBHOOK_READ_TIMEOUT_MS=10000
WEBHOOK_RETRY_DELAYS_SECONDS=60,300,1800
WEBHOOK_MAX_ATTEMPTS=4
WEBHOOK_ALLOW_TRANSCRIPT_EVENT=false
